{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokemon-card-pricing",
  "main": "src/stable-worker.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "secrets": {
    "required": [
      "THE_CARD_API_KEY"
    ]
  }
}
